# Supabase Configuration
# Create .env.local, then paste these values from Supabase Project Settings > API.
NEXT_PUBLIC_SITE_URL=https://rees52.tech
# Add the token from Google Search Console after verifying your domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional GA4 measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only key. Keep this private and never expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional legacy alias used by older local builds. Leave blank when ANON_KEY is set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# Nodemailer SMTP Configuration (For actual email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM_NAME=REES52 Learning
# Custom texts for OTP emails (Optional)
# SMTP_OTP_SUBJECT=Password Reset Verification Code - REES52
# SMTP_OTP_GREETING=Hello Maker,
# SMTP_OTP_BODY=You requested to reset your password. Use the following 6-digit verification code to complete your reset request:
# SMTP_OTP_FOOTER=This verification code is valid for 10 minutes. If you did not request this code, you can safely ignore this message.

# OpenRouter API Configuration (For AELOS AI Chatbot)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Server-only secrets. Use independent random values of at least 32 characters.
# JWT_SECRET is used only by the development-only local auth fallback.
JWT_SECRET=replace-with-a-random-32-plus-character-secret
OTP_SECRET=replace-with-a-different-random-32-plus-character-secret

# Key used to obfuscate internal page paths in the browser address bar.
# This is not an authorization control; use a random value and rotate deliberately.
OPAQUE_ROUTE_KEY=replace-with-a-random-32-plus-character-route-key

# Never enable this in production. It exposes reset codes in the local UI so
# automated tests can exercise the recovery flow without sending email.
ENABLE_DEV_OTP=false
# User roles are stored in public.profiles.role. New accounts are always
# students. Promote trusted staff to role "teacher" from the Supabase dashboard
# or another service-role-only workflow after applying migration 004.
