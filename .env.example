# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# Nodemailer SMTP Configuration (For actual email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM_NAME=REES52 Learning
# Custom texts for OTP emails (Optional)
# SMTP_OTP_SUBJECT=Password Reset Verification Code - REES52
# SMTP_OTP_GREETING=Hello Maker,
# SMTP_OTP_BODY=You requested to reset your password. Use the following 6-digit verification code to complete your reset request:
# SMTP_OTP_FOOTER=This verification code is valid for 10 minutes. If you did not request this code, you can safely ignore this message.

# OpenRouter API Configuration (For AELOS AI Chatbot)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# JWT Authentication Secret Key
JWT_SECRET=your-jwt-secret-key-goes-here
